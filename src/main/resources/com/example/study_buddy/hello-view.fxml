<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="1100.0" spacing="14.0"
      stylesheets="@styles.css" styleClass="main-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.study_buddy.HelloController">
    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="14.0" />
    </padding>

    <!-- Top Navigation & Toolbar -->
    <HBox fx:id="appTopBar" alignment="CENTER_LEFT" spacing="12.0"
          style="-fx-background-color: #ffffff; -fx-padding: 12px 18px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">

        <!-- Left Sidebar Toggle Button -->
        <Button fx:id="leftToggleBtn" onAction="#handleToggleLeft" styleClass="btn-toggle" text="☰" />

        <VBox spacing="2.0">
            <Label styleClass="form-title" text="Study Buddy 🎓" />
            <Label fx:id="welcomeText" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4f46e5;" text="Class Routine" />
            <Label fx:id="userDetailText" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Connected" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />



        <!-- Right Sidebar Toggle Button (Shows on Homepage only) -->
        <Button fx:id="rightToggleBtn" onAction="#handleToggleRight" styleClass="btn-toggle" text="📋" />
    </HBox>

    <!-- Main Workspace with Collapsible Left and Right Sidebars -->
    <HBox alignment="TOP_CENTER" spacing="14.0" VBox.vgrow="ALWAYS">

        <!-- Left Sidebar (Collapsible with smooth animation, closed by default) -->
        <VBox fx:id="leftSidebar" maxWidth="0.0" minWidth="0.0" prefWidth="0.0" spacing="12.0"
              visible="false" managed="false"
              style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-padding: 16px;">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Navigation" />
            </HBox>
            <VBox fx:id="leftSidebarContent" spacing="8.0" VBox.vgrow="ALWAYS">
                <Button fx:id="navHomeBtn" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleOpenMainMenu" styleClass="nav-item" text="🏠  Main Menu" />
                <Button fx:id="navRoutineBtn" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleOpenRoutine" styleClass="nav-item" text="📅  Class Routine" />
                <Button fx:id="navCalendarBtn" alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#handleOpenCalendar" styleClass="nav-item" text="🗓️  Calendar" />
            </VBox>

            <!-- Bottom Section: Logout Button -->
            <VBox spacing="8.0" style="-fx-padding: 10px 0 0 0; -fx-border-color: #f1f5f9; -fx-border-width: 1px 0 0 0;">
                <Button fx:id="logoutButton" alignment="CENTER" maxWidth="Infinity" onAction="#handleLogout" styleClass="btn-logout" text="🚪 Log Out" />
            </VBox>
        </VBox>

        <!-- Center Workspace: StackPane supporting Main Menu (Blank) & Routine Views -->
        <StackPane fx:id="centerWorkspace" HBox.hgrow="ALWAYS">
            <!-- View 1: Main Menu (Notebooks Dashboard) -->
            <VBox fx:id="mainMenuView" alignment="TOP_LEFT" spacing="20.0"
                  style="-fx-background-color: #ffffff; -fx-padding: 28px; -fx-background-radius: 10px; -fx-border-color: #cbd5e1; -fx-border-radius: 10px;">
                
                <!-- Notebooks Header & Actions Bar -->
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <Label text="Recent notebooks" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                    <Button fx:id="myNotebooksBtn" onAction="#handleMyNotebooks" styleClass="btn-secondary-action" text="📚 My Notebooks" />
                    <Button fx:id="newNotebookBtn" onAction="#handleNewNotebook" styleClass="btn-primary" text="+ New Notebook" />
                </HBox>

                <!-- Notebooks Scrollable Content Area -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="notebooksContentArea" spacing="16.0" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="notebooksGrid" hgap="20.0" vgap="20.0">
                            <!-- Populated dynamically in HelloController -->
                        </FlowPane>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- View 2: Class Routine View (Exact previous routine layout) -->
            <ScrollPane fx:id="routineView" fitToHeight="true" fitToWidth="true" visible="false" managed="false"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 10px;">
                <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px;">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Routine" />
                    </HBox>

                    <GridPane fx:id="routineGrid" alignment="TOP_LEFT" hgap="10.0" vgap="10.0">
                        <!-- Dynamically built in HelloController -->
                    </GridPane>
                </VBox>
            </ScrollPane>

            <!-- View 3: Google Calendar-Style Interactive Monthly Calendar View -->
            <VBox fx:id="calendarView" spacing="12.0" visible="false" managed="false"
                  style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 10px; -fx-border-color: #cbd5e1; -fx-border-radius: 10px;">
                
                <!-- Calendar Header Bar: Month/Year Dropdown Selectors, Navigation (Prev, Today, Next), and + Add Task button -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-padding: 0 0 12px 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <ComboBox fx:id="calendarMonthSelect" styleClass="calendar-select-box" prefWidth="145.0" />
                        <ComboBox fx:id="calendarYearSelect" styleClass="calendar-select-box" prefWidth="95.0" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Button onAction="#handlePrevMonth" styleClass="btn-secondary-action" text="◀" />
                        <Button onAction="#handleToday" styleClass="btn-secondary-action" text="Today" />
                        <Button onAction="#handleNextMonth" styleClass="btn-secondary-action" text="▶" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleAddNewCalendarTask" styleClass="btn-primary" text="+ Add Task" />
                </HBox>

                <!-- Day Headers (Sun - Sat) -->
                <GridPane fx:id="calendarDayHeaders" hgap="6.0" style="-fx-padding: 4px 0;" />

                <!-- Scrollable Monthly Grid -->
                <ScrollPane fitToWidth="true" fitToHeight="true"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <GridPane fx:id="calendarGrid" hgap="6.0" vgap="6.0" VBox.vgrow="ALWAYS" />
                </ScrollPane>
            </VBox>

            <!-- View 4: Notebook Workspace View (Topics & Pages Explorer + Playground) -->
            <VBox fx:id="notebookWorkspaceView" spacing="12.0" visible="false" managed="false"
                  style="-fx-background-color: #ffffff; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #cbd5e1; -fx-border-radius: 10px;">
                
                <!-- Workspace Top Bar: Back Button, Topics Toggle, Breadcrumb, Status -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 0 0 10px 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;">
                    <Button onAction="#handleBackToDashboard" styleClass="btn-secondary-action" text="◀ Back to Notebooks" />
                    <Button fx:id="toggleTopicsBtn" onAction="#handleToggleTopicsSidebar" styleClass="btn-secondary-action" text="📂 Topics" />
                    <Label fx:id="notebookBreadcrumbLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Notebook Title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="workspaceStatusLabel" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="" />
                </HBox>

                <!-- Workspace Split/Dual Area: Topics Explorer (Left) & Page Playground (Right) -->
                <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                    <!-- Left Column: Topics Explorer Pane (Collapsible Sidebar) -->
                    <VBox fx:id="topicsSidebar" prefWidth="280.0" minWidth="0.0" maxWidth="320.0" spacing="10.0"
                          style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="TOPICS" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#promptAddTopic" style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand; -fx-background-radius: 4px; -fx-padding: 4px 10px;" text="+ Add Topic" />
                            <Button onAction="#handleCloseTopicsSidebar" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 2px 6px;" text="✕" />
                        </HBox>

                        <ScrollPane fitToWidth="true" fitToHeight="true"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <VBox fx:id="topicsListContainer" spacing="10.0">
                                <!-- Dynamically populated topics list -->
                            </VBox>
                        </ScrollPane>
                    </VBox>

                    <!-- Right Column: Page Playground Area -->
                    <VBox fx:id="pagePlaygroundContainer" spacing="14.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <!-- Dynamically populated page canvas / empty prompt -->
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>

        <!-- Right Sidebar (Tasks & Deadlines, Collapsible with smooth animation, closed by default) -->
        <VBox fx:id="rightSidebar" maxWidth="0.0" minWidth="0.0" prefWidth="0.0" spacing="12.0"
              visible="false" managed="false"
              style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-padding: 16px;">
            
            <!-- Tasks Header: Title, Count Badge, Close Button -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 0 8px 0; -fx-border-color: #f1f5f9; -fx-border-width: 0 0 1px 0;">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="📋 Tasks &amp; Deadlines" />
                <Label fx:id="taskCountBadge" style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 2px 7px;" text="0" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleToggleRight" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 2px 6px;" text="✕" />
            </HBox>

            <!-- Scrollable Tasks List -->
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="tasksContainer" spacing="10.0">
                    <!-- Populated dynamically with live ticking countdown cards -->
                </VBox>
            </ScrollPane>
        </VBox>

    </HBox>

</VBox>
